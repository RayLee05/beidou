# 统一换行与二进制标记，避免 Windows 下 CRLF 污染 diff
* text=auto eol=lf
*.png binary
*.pdf binary
*.bin binary
*.dat binary
*.vcd binary
*.fsdb binary

# Preserve exact tool evidence bytes so SHA256SUMS survives cloning on Windows.
# Raw tool formatting includes trailing spaces and terminal blank lines.
logic_synth/evidence/20261109/* -text whitespace=-blank-at-eol,-blank-at-eof
